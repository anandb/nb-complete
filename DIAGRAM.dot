        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+getState() : SessionState<BR/>+transitionTo(SessionState) : boolean<BR/>+transitionToIf(SessionState, SessionState) : boolean<BR/>+addListener / +removeListener<BR/>+canSendMessage() / +canStopMessage() / +canLoadSession()</FONT></TD></TR>
        </TABLE>
