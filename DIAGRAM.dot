        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+registerTool(String, String, ObjectNode, ToolExecutor)<BR/>+unregisterTool(String)<BR/>+getToolList() : ArrayNode<BR/>+hasTool(String) / +toolCount() : int<BR/>+getToolNames() : List&lt;String&gt;<BR/>+callTool(String, JsonNode) : JsonNode</FONT></TD></TR>
        </TABLE>
    >]

    McpToolDefinition [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD ALIGN="LEFT"><B>McpToolDefinition</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">-name, -description : String<BR/>-inputSchema : ObjectNode</FONT></TD></TR>
        </TABLE>
    >]

