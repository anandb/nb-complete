    /* ================================================================ */
    /* MCP Layer — Tool Server                                          */
    /* ================================================================ */
    subgraph cluster_mcp {
        label="MCP Layer"
        style=solid
        color="#888888"
        fontcolor="#666666"
        fontsize=11

    McpManager [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD ALIGN="LEFT"><B>McpManager</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">-ExecutorService startExecutor / McpServer server<BR/>-AtomicBoolean disabled / Thread startThread</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+start() / +stop() / +disable()<BR/>+waitForReady() : CompletableFuture&lt;Void&gt;<BR/>+isDisabled() : boolean<BR/>+getServerConfig() : List&lt;Map&gt;<BR/>+getMcpTools() : McpTools<BR/>+checkServerSupport(JsonNode)</FONT></TD></TR>
        </TABLE>
    >]

    McpToolAdapter [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;ToolExecutor&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>McpToolAdapter</B> <FONT COLOR="gray">(contract ToolExecutor)</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">-McpManager delegate</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+start() / +stop() / +disable()<BR/>+waitForReady() : CompletableFuture&lt;Void&gt;<BR/>+isDisabled() : boolean<BR/>+checkServerSupport(JsonNode)<BR/>+getServerConfig() : List&lt;Map&gt;</FONT></TD></TR>
        </TABLE>
    >]

    McpServer [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD ALIGN="LEFT"><B>McpServer</B> <FONT COLOR="gray">(Jetty Server)</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+MAX_THREADS$ : int<BR/>-McpTools mcpTools<BR/>-String token / Server server<BR/>-ServerConnector connector</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+start() / +stop() / +isRunning()<BR/>+getUrl() : String<BR/>+getToken() : String<BR/>+getMcpTools() : McpTools</FONT></TD></TR>
        </TABLE>
    >]

    McpTools [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
