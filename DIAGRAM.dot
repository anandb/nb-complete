    subgraph cluster_manager {
        label="Manager Layer"
        style=solid
        color="#888888"
        fontcolor="#666666"
        fontsize=11

    SessionManager [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;SessionControl, SessionQuery&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>SessionManager</B> <FONT COLOR="gray">(SessionControl, SessionQuery)</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">-CopyOnWriteArrayList&lt;SessionListener&gt; listeners<BR/>-SessionStateMachine stateMachine<BR/>-String currentSessionId (vol)<BR/>-String lastProjectDir (vol)<BR/>-SessionCacheManager cacheManager<BR/>-SessionRpcClient rpcClient<BR/>-BiFunction beforePreambleHandler (vol)</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+getInstance() : SessionManager$<BR/>+createSession(String) : CompletableFuture&lt;Session&gt;<BR/>+loadSession(String[, boolean]) : boolean<BR/>+renameSession(String, String)<BR/>+createNewSession(String)<BR/>+stopCurrentMessage()<BR/>+onTurnEnded()<BR/>+closeSession()<BR/>+setHidden(String, boolean)<BR/>+setContextUsage(String, long, long)<BR/>+setBeforePreambleHandler(BiFunction)<BR/>+scheduleManualReconnectPrompt()<BR/>+isDescendantOfCurrent(String) : boolean</FONT></TD></TR>
        </TABLE>
    >]

    ProcessManager [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;ProcessControl&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>ProcessManager</B> <FONT COLOR="gray">(ProcessControl)</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">-AtomicReference&lt;AcpProtocolClient&gt; rpcClient<BR/>-ServerProcessLifecycle serverLifecycle<BR/>-AcpReconnectManager reconnectManager<BR/>-AcpRequestRouter requestRouter<BR/>-ToolExecutor toolExecutor<BR/>-SlashCommandInterceptor slashCmdInterceptor<BR/>-List&lt;Consumer&gt; sseListeners</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+getInstance() : ProcessManager$<BR/>+ensureStarted()<BR/>+restartServer()<BR/>+shutdown()<BR/>+sendMessage(...) : CompletableFuture&lt;JsonNode&gt;<BR/>+sendRequest(...) : CompletableFuture&lt;JsonNode&gt;<BR/>+sendNotification(String, Object)<BR/>+stopMessage(String) : CompletableFuture&lt;Void&gt;<BR/>+addSseListener / +removeSseListener<BR/>+whenReady() : CompletableFuture&lt;Void&gt;</FONT></TD></TR>
        </TABLE>
    >]

    AcpProtocolClient [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;Closeable&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>AcpProtocolClient</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">-AtomicLong nextId<BR/>-InputStream inputStream<BR/>-BufferedWriter writer<BR/>-WireLogger wireLogger<BR/>-long lastDataTime (vol)<BR/>-Map&lt;Long,CompletableFuture&gt; pendingRequests<BR/>-Map&lt;String,RequestHandler&gt; requestHandlers<BR/>-Map&lt;Long,Long&gt; requestIdleTimeouts<BR/>-Map&lt;String,Consumer&gt; notificationListeners</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+sendRequest(String, Object[, long, TimeUnit])<BR/>+sendNotification(String, Object)<BR/>+onNotification(String, Consumer)<BR/>+onRequest(String, RequestHandler)<BR/>+setDisconnectionHandler(Runnable)<BR/>+start() / +close()<BR/>+touch() / +setPermissionRequestPending(boolean)</FONT></TD></TR>
        </TABLE>
    >]

