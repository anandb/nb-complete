digraph CodingAssistant {
    rankdir=LR
    bgcolor="white"
    fontname="Helvetica"
    node [shape=none fontname="Helvetica" fontsize=9]
    edge [fontname="Helvetica" fontsize=7 color="#555555"]
    ranksep=1.2
    nodesep=0.4
    splines=true
    compound=true

/* HEAD: 38afcaa feat: pulse restart button, disable new session when binary missing, polish copy UX */
/* Diagram refreshed for v1.12.9 — adds model, project, platform layers + many new ports */
/* ================================================================ */
/* Contract Layer — Interfaces & Ports                               */
/* ================================================================ */
    subgraph cluster_contract {
        label="Contract Layer"
        style=solid
        color="#888888"
        fontcolor="#666666"
        fontsize=11

    SessionQuery [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;interface&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>SessionQuery</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+getCurrentSessionId() : String<BR/>+getCurrentSessionDirectory() : String<BR/>+getCurrentState() : SessionState<BR/>+loadSessionFromServer(String, String) : CompletableFuture&lt;List&lt;SessionConfigOption&gt;&gt;<BR/>+getCustomTitle(String, String) : String<BR/>+getSessionTitle(String) : String<BR/>+getContextUsage(String) : String<BR/>+isDescendantOfCurrent(String) : boolean<BR/>+isHidden(String) : boolean</FONT></TD></TR>
        </TABLE>
    >]

    SessionControl [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;interface&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>SessionControl</B> <FONT COLOR="gray">(extends SessionQuery)</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+addSessionListener(SessionListener)<BR/>+removeSessionListener(SessionListener)<BR/>+createSession(String) : CompletableFuture&lt;Session&gt;<BR/>+loadSession(String) : boolean<BR/>+loadSession(String, boolean) : boolean<BR/>+setSessionConfigOption(String, String, String) : CompletableFuture&lt;Void&gt;<BR/>+renameSession(String, String)<BR/>+setBeforePreambleHandler(BiFunction)<BR/>+createNewSession(String)<BR/>+closeSession()<BR/>+refreshSessions()<BR/>+refreshSessionList()<BR/>+stopCurrentMessage()<BR/>+onTurnEnded()<BR/>+canSendMessage() : boolean<BR/>+canStopMessage() : boolean<BR/>+forceCancelCurrentMessage()<BR/>+setHidden(String, boolean)<BR/>+setContextUsage(String, long, long)<BR/>+scheduleManualReconnectPrompt()</FONT></TD></TR>
        </TABLE>
    >]

    ProcessControl [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;interface&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>ProcessControl</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+ensureStarted()<BR/>+restartServer()<BR/>+sendMessage(String, String, Map) : CompletableFuture&lt;JsonNode&gt;<BR/>+sendMessage(String, String, Map, List) : CompletableFuture&lt;JsonNode&gt;<BR/>+stopMessage(String) : CompletableFuture&lt;Void&gt;<BR/>+whenReady() : CompletableFuture&lt;Void&gt;<BR/>+touchConnection()<BR/>+getToolExecutor() : ToolExecutor<BR/>+getSlashCommandInterceptor() : SlashCommandInterceptor<BR/>+setPermissionHandler(PermissionHandler)<BR/>+setStatusListener(Consumer&lt;String&gt;)<BR/>+setCrashHandler(Runnable)<BR/>+getAvailableCommands() : List&lt;AvailableCommand&gt;<BR/>+shutdown()</FONT></TD></TR>
        </TABLE>
    >]

    ToolExecutor [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;interface&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>ToolExecutor</B> <FONT COLOR="gray">(contract port)</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+start()<BR/>+stop()<BR/>+waitForReady() : CompletableFuture&lt;Void&gt;<BR/>+disable()<BR/>+isDisabled() : boolean<BR/>+checkServerSupport(JsonNode)<BR/>+getServerConfig() : List&lt;Map&gt;</FONT></TD></TR>
        </TABLE>
    >]

    SessionListener [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;interface&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>SessionListener</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+onSessionListUpdated(List&lt;Session&gt;)<BR/>+onSessionStarted(String)<BR/>+onSessionLoaded(String, List, boolean)<BR/>+onSessionLoading(boolean)<BR/>+onSessionProgress(int)<BR/>+onSessionError(String)<BR/>+onSessionUpdate(SessionUpdate)<BR/>+onPreambleDone()<BR/>+onSessionRenamed(String)<BR/>+onAllProjectsClosed()<BR/>+onInternalMessageSent()<BR/>+onInternalMessageDone()</FONT></TD></TR>
        </TABLE>
    >]

    UpdateDispatcher [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;interface&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>UpdateDispatcher</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+handle(SessionUpdate, UIHandler)</FONT></TD></TR>
        </TABLE>
    >]

    UIHandler [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;interface&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>UIHandler</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+displayMessage(ProcessedMessage)<BR/>+updateConfig(List&lt;SessionConfigOption&gt;)<BR/>+refreshSessions()<BR/>+updateUsage(long, long)</FONT></TD></TR>
        </TABLE>
    >]

    RequestHandler [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;interface&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>RequestHandler</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+handle(JsonNode) : CompletableFuture&lt;JsonNode&gt;</FONT></TD></TR>
        </TABLE>
    >]

    PermissionHandler [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;interface&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PermissionHandler</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+handlePermissionRequest(String, JsonNode, CompletableFuture&lt;String&gt;)</FONT></TD></TR>
        </TABLE>
    >]

    SlashCommandHandler [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;interface&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>SlashCommandHandler</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+handle(String, Lookup) : CompletableFuture&lt;Boolean&gt;</FONT></TD></TR>
        </TABLE>
    >]

    SlashCommandProvider [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;interface&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>SlashCommandProvider</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+getCommand() : String<BR/>+getDescription() : String<BR/>+getHandler() : SlashCommandHandler</FONT></TD></TR>
        </TABLE>
    >]

    SlashCommandCallback [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;interface&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>SlashCommandCallback</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+expandOptionsPanel()<BR/>+popupModelCombo()<BR/>+popupAgentCombo()<BR/>+popupThinkingCombo()<BR/>+popupSessionCombo()<BR/>+popupNewSession()<BR/>+popupArchiveSession()<BR/>+displayToolMessage(String, String)<BR/>+onAsyncSendStarted()<BR/>+onAsyncSendCompleted()</FONT></TD></TR>
        </TABLE>
    >]

    SlashCommandInterceptor [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;interface&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>SlashCommandInterceptor</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+setCallback(SlashCommandCallback)<BR/>+getCallback() : SlashCommandCallback<BR/>+intercept(String, Lookup) : CompletableFuture&lt;Boolean&gt;<BR/>+registerCommand(String, SlashCommandHandler, String)<BR/>+getCommands() : Map&lt;String, CommandInfo&gt;</FONT></TD></TR>
        </TABLE>
    >]

    PasteCallback [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;interface&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PasteCallback</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+canAddAttachment() : boolean<BR/>+onAttachmentAdded(AttachedFile)<BR/>+onError(String)<BR/>+onAttachmentLimitReached()</FONT></TD></TR>
        </TABLE>
    >]

    FileCacheQuery [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;interface&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>FileCacheQuery</B> <FONT COLOR="gray">(+CachedFile record)</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+isReady() : boolean<BR/>+getAllFiles() : Collection&lt;CachedFile&gt;<BR/>+onReady(Runnable)<BR/>+getCacheVersion() : long</FONT></TD></TR>
        </TABLE>
    >]

    PinnedMessageControl [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;interface&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PinnedMessageControl</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+isPinned(String, String) : boolean<BR/>+setPinned(String, String, boolean)<BR/>+loadSession(String)<BR/>+retainPinned(String, Set&lt;String&gt;)<BR/>+unloadSession(String)</FONT></TD></TR>
        </TABLE>
    >]

    UpdateCheckerControl [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;interface&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>UpdateCheckerControl</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+start()<BR/>+onInstallOrUpgrade()</FONT></TD></TR>
        </TABLE>
    >]

    StashDiffControl [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;interface&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>StashDiffControl</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+openStashDiff(File, int)<BR/>+validateStash(File, int) : String</FONT></TD></TR>
        </TABLE>
    >]

    VcsIgnoreStrategy [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;interface&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>VcsIgnoreStrategy</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+isAvailable(File) : boolean<BR/>+listNonIgnoredFiles(File) : Set&lt;String&gt;<BR/>+isIgnored(File, File) : boolean</FONT></TD></TR>
        </TABLE>
    >]

    }  /* end cluster_contract */

    /* ================================================================ */
    /* Model Layer — Data Classes & Records                              */
    /* ================================================================ */
    subgraph cluster_model {
        label="Model Layer"
        style=solid
        color="#888888"
        fontcolor="#666666"
        fontsize=11

    MessageType [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;enum&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>MessageType</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">agent_message_chunk, agent_thought_chunk<BR/>available_commands_update, plan<BR/>tool_call, tool_call_update, usage_update<BR/>user_message_chunk, config_options_update<BR/>session_info_update, message, error_response<BR/>responding_finished, end_turn</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+isThought() : boolean<BR/>+isTool() : boolean<BR/>+isUser() : boolean<BR/>+isAssistant() : boolean<BR/>+roleName() : String</FONT></TD></TR>
        </TABLE>
    >]

    SessionState [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;enum&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>SessionState</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">IDLE, LOADING, STREAMING, STOPPING</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+canTransitionTo(SessionState) : boolean<BR/>+canSendMessage() : boolean<BR/>+canLoadSession() : boolean<BR/>+canStopMessage() : boolean<BR/>+isActive() : boolean</FONT></TD></TR>
        </TABLE>
    >]

    ColorKey [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;enum&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>ColorKey</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">background, foreground, selection, accent<BR/>bubble_user, bubble_assistant, bubble_border<BR/>code_*, thinking_header_*, permission_*<BR/>table_*, scroll_button_color, ... (45 keys)</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+fromJsonName(String) : ColorKey$</FONT></TD></TR>
        </TABLE>
    >]

    Session [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;record&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>Session</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">-id, -title, -cwd, -directory : String<BR/>-parentID, -updatedAt : String<BR/>-mcpServers : List&lt;Object&gt;<BR/>-configOptions : List&lt;SessionConfigOption&gt;</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+effectiveDirectory() : String<BR/>+projectName() : String</FONT></TD></TR>
        </TABLE>
    >]

    SessionUpdate [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;record&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>SessionUpdate</B> <FONT COLOR="gray">(+Params, +UpdateData, +AvailableCommand, +RawInput)</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">-jsonrpc, -method : String<BR/>-params : Params</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+type() : String<BR/>+message() : Message<BR/>+isThinking() : Boolean<BR/>+content() : JsonNode<BR/>+messageId() : String<BR/>+toolCallId() : String<BR/>+status() : String<BR/>+kind() : String<BR/>+update() : UpdateData</FONT></TD></TR>
        </TABLE>
    >]

    SessionConfigOption [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;record&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>SessionConfigOption</B> <FONT COLOR="gray">(+SessionConfigSelectOption)</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">-id, -name, -description : String<BR/>-category, -type, -currentValue : String<BR/>-options : List&lt;SessionConfigSelectOption&gt;</FONT></TD></TR>
        </TABLE>
    >]

    SessionItem [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD ALIGN="LEFT"><B>SessionItem</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">-session : Session<BR/>-title : String</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+toString() : String</FONT></TD></TR>
        </TABLE>
    >]

    Message [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;record&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>Message</B> <FONT COLOR="gray">(+Prompt, +Completion, +ContentPart, +ToolCall, +ToolResult, +Annotations)</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">-id, -type, -state : String<BR/>-prompt : Prompt<BR/>-completion : Completion</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+extractRole() : String<BR/>+extractText() : String</FONT></TD></TR>
        </TABLE>
    >]

    ProcessedMessage [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;record&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>ProcessedMessage</B> <FONT COLOR="gray">(+Builder)</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">-messageType : MessageType<BR/>-text, -messageId, -kind : String<BR/>-toolTitle, -rawText : String<BR/>-streaming : boolean<BR/>-status : String</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+isIgnorable() : boolean<BR/>+isIgnorable(String, String) : boolean$<BR/>+createError(MessageType, String, String, String) : ProcessedMessage$</FONT></TD></TR>
        </TABLE>
    >]

    MessageTransformer [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD ALIGN="LEFT"><B>MessageTransformer</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+convert(Message) : ProcessedMessage</FONT></TD></TR>
        </TABLE>
    >]

    ToolCallData [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD ALIGN="LEFT"><B>ToolCallData</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">-toolCallId, -title, -command : String<BR/>-kind, -status, -text : String<BR/>-lastDisplayedText : String</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+setTitle(String) : String<BR/>+setCommand(String) : String<BR/>+setKind(String) : String<BR/>+setStatus(String) : String<BR/>+setText(String) : String<BR/>+shouldDisplay(String) : boolean<BR/>+isDone() : boolean</FONT></TD></TR>
        </TABLE>
    >]

    AttachedFile [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;record&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>AttachedFile</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">-filename, -mimeType, -base64Data : String<BR/>-size : long</FONT></TD></TR>
        </TABLE>
    >]

    ColorRegistry [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD ALIGN="LEFT"><B>ColorRegistry</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">-isDark : boolean<BR/>-colors : EnumMap&lt;ColorKey, Color&gt;</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+get(ColorKey) : Color<BR/>+toHex(ColorKey) : String<BR/>+fromJson(JsonNode, boolean) : ColorRegistry$</FONT></TD></TR>
        </TABLE>
    >]

    ModelRecords [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;utility&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>ModelRecords</B> <FONT COLOR="gray">(nested records)</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">Agent(name, description)<BR/>CommandInfo(handler, description)<BR/>ConfigItem(name, value, baseName)<BR/>MessageClassification(type, kind)<BR/>PlanEntry(priority, status, content)</FONT></TD></TR>
        </TABLE>
    >]

    }  /* end cluster_model */

    /* ================================================================ */
    /* Support Layer — Utilities & Constants                             */
    /* ================================================================ */
    subgraph cluster_support {
        label="Support Layer"
        style=solid
        color="#888888"
        fontcolor="#666666"
        fontsize=11

    PreferenceKeys [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;constants&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PreferenceKeys</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+MODULE_ANCHOR$ : Class<BR/>+ACP_EXECUTABLE_PATH$ : String<BR/>+PROCESS_ARGUMENTS$ : String<BR/>+MAX_MESSAGES$, +INPUT_HISTORY_*$<BR/>+TOOLBAR_*$ (archive, new_session, rename, reload, keep, ...)<BR/>+ACTIONS_*$ (sort_lines, stash_diff, quick_jump)<BR/>+MINI_ASSISTANT_*$ (x, y, width, height, input_height)<BR/>+CHAT_FONT_SIZE$, +TOOLBAR_ICON_SIZE$<BR/>+UPDATE_URL$, +CHECK_FOR_UPDATES$<BR/>+HELP_FLASH_PENDING$, +AUTO_BACKUP_CHANGES$</FONT></TD></TR>
        </TABLE>
    >]

    PluginSettings [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;utility&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PluginSettings</B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Courier">+getDefaultPreamble() : String$<BR/>+getCriticalRules() : String$<BR/>+getPreamble() : String$ / +setPreamble(String)$<BR/>+getCustomUserIcon() / +setCustomUserIcon(String)$<BR/>+getSessionIdleTimeout() : int$ / +setSessionIdleTimeout(int)$<BR/>+getMaxMessages() : int$ / +setMaxMessages(int)$<BR/>+getToolbarIconSize() : int$ / +setToolbarIconSize(int)$<BR/>+getChatFontSize() / +setChatFontSize(int)$<BR/>+isSortLinesEnabled() / +isStashDiffEnabled()$<BR/>+isQuickJumpEnabled() / +isAutoBackupChanges()$</FONT></TD></TR>
        </TABLE>
    >]

    TimingConstants [label=<
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white">
        <TR><TD><FONT COLOR="gray"><I>&lt;&lt;constants&gt;&gt;</I></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>TimingConstants</B></TD></TR>
