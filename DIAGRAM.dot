    AssistantCodeGenerator -> AssistantTopComponent [arrowhead=odot style=dashed color="#8A8A8A" fontcolor="#8A8A8A" label="findInstance + input"]
    PreferenceKeys -> PluginSettings [arrowhead=odot style=dashed color="#8A8A8A" fontcolor="#8A8A8A" label="constants"]
    PluginSettings -> PrefStore [arrowhead=odot style=dashed color="#2E6E2E" fontcolor="#2E6E2E" label="via bridge"]
    FsWriteSettings -> PreferenceKeys [arrowhead=odot style=dashed color="#8A8A8A" fontcolor="#8A8A8A" label="system property"]
    BinaryResolver -> HarnessCatalog [arrowhead=odot style=dashed color="#2E6E2E" fontcolor="#2E6E2E" label="resolves harness binaries"]
    TaskQueryProvider -> SlidingTask [arrowhead=odot style=dashed color="#AD1457" fontcolor="#AD1457" label="reload/push slots"]
    subgraph cluster_legend {
        label="Legend" style=dashed color="#666666" fontcolor="#666666" fontsize=10
        legend_node [shape=none label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
        <TR><TD BGCOLOR="#8D4E00" ALIGN="LEFT">Contract Layer</TD></TR>
        <TR><TD BGCOLOR="#512DA8" ALIGN="LEFT">Model Layer</TD></TR>
        <TR><TD BGCOLOR="#2E6E2E" ALIGN="LEFT">Support Layer</TD></TR>
        <TR><TD BGCOLOR="#0B5394" ALIGN="LEFT">Manager Layer</TD></TR>
        <TR><TD BGCOLOR="#006D75" ALIGN="LEFT">MCP Layer</TD></TR>
        <TR><TD BGCOLOR="#AD1457" ALIGN="LEFT">Tasks Layer (todo.txt feature)</TD></TR>
        <TR><TD BGCOLOR="#6A1B9A" ALIGN="LEFT">Project Layer</TD></TR>
        <TR><TD BGCOLOR="#9A6A00" ALIGN="LEFT">UI Layer</TD></TR>
        <TR><TD BGCOLOR="#37474F" ALIGN="LEFT">platform/ (UI-side seams)</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#2E7D32">solid green — implements / extends</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#E65100">solid orange — composition / creates / owns</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#1565C0">dashed blue — uses / delegates</FONT></TD></TR>
        </TABLE>
    >]
    }
}