body {
    font-family: $fontFamily;
    font-size: $fontSize;
    color: $fg;
    background: $bg;
    margin: 0;
    padding: 16px;
    line-height: 1.4;
}
.chat-container {
    max-width: 800px;
    margin: 0 auto;
}
.chat-header {
    text-align: center;
    padding: 8px 0 16px;
    border-bottom: 1px solid $borderColor;
    margin-bottom: 16px;
}
.chat-header h1 {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
}
.header-date {
    font-size: 11px;
    color: $muted;
}
.message {
    display: flex;
    margin-bottom: 4px;
    gap: 8px;
    align-items: flex-start;
}
.message.user {
    justify-content: flex-start;
}
.message.assistant {
    flex-direction: row;
}
.message.thought,
.message.tool {
    flex-direction: row;
}
.bubble {
    width: 80%;
    padding: 8px 12px;
    word-wrap: break-word;
    overflow-wrap: break-word;
}
.bubble-header {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
}
.bubble-header .avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
}
.user-bubble {
    background: $userBg;
    border-radius: 16px 16px 4px 16px;
}
.assistant-bubble {
    background: $assistantBg;
    border-radius: 16px 16px 16px 4px;
}
.content p,
.content div,
.content h1,
.content h2,
.content h3,
.content h4,
.content h5,
.content h6 {
    margin: 2px 0;
    text-align: left;
}
.content ul,
.content ol {
    padding-left: 20px;
    margin: 4px 0;
}
.content li {
    margin: 2px 0;
}
.content table {
    width: 100%;
    border-collapse: collapse;
    margin: 8px 0;
    background: $tableBg;
}
.content th {
    background: $tableHeaderBg;
    padding: 8px;
    border: 1px solid $borderColor;
    text-align: left;
    font-weight: bold;
}
.content td {
    padding: 8px;
    border: 1px solid $borderColor;
    vertical-align: top;
}
.content tr:nth-child(even) td {
    background: $tableAlternate;
}
.content a {
    color: $linkColor;
    text-decoration: none;
    font-weight: 500;
}
.content a:hover {
    text-decoration: underline;
}
.content pre {
    background: $codeBg;
    color: $codeFg;
    padding: 10px;
    border-radius: 4px;
    font-family: $monoFamily;
    font-size: 13px;
    overflow-x: auto;
    margin: 6px 0;
    white-space: pre-wrap;
    word-wrap: break-word;
}
.content code {
    background: rgba(255,255,255,0.1);
    padding: 2px 4px;
    border-radius: 3px;
    font-family: $monoFamily;
    font-size: 12px;
}
.activity {
    margin: 2px 0;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid $borderColor;
    width: 80%;
}
.activity-pane > summary {
    padding: 6px 10px;
    background: $base2;
    cursor: pointer;
    font-weight: bold;
    font-size: 13px;
    display: flex;
    align-items: center;
    gap: 6px;
    user-select: none;
    width: 100%;
    box-sizing: border-box;
}
.activity-pane > summary img {
    width: 16px;
    height: 16px;
}
.activity-pane > summary::-webkit-details-marker {
    display: none;
}
.activity-pane > summary::before {
    content: '▶';
    margin-right: 4px;
    font-size: 10px;
}
.activity-pane[open] > summary::before {
    content: '▼';
}
.segment {
    margin: 0;
    border-top: 1px solid $borderColor;
    width: 100%;
    box-sizing: border-box;
}
.segment summary {
    padding: 4px 8px 4px 24px;
    font-size: 12px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 4px;
    user-select: none;
    border-left: 4px solid transparent;
    background: $base2;
}
.segment.thought summary {
    border-left-color: $yellow;
}
.segment.tool summary {
    border-left-color: $accent;
}
.segment summary img {
    width: 16px;
    height: 16px;
}
.segment summary::-webkit-details-marker {
    display: none;
}
.segment summary::before {
    content: '▶';
    margin-right: 4px;
    font-size: 10px;
    color: $muted;
}
.segment[open] > summary::before {
    content: '▼';
}
.segment-body {
    padding: 8px 12px 8px 28px;
    font-size: 13px;
    line-height: 1.3;
    border-left: 4px solid transparent;
    border-left-color: inherit;
}
.segment-body pre {
    background: $codeBg;
    color: $codeFg;
    padding: 8px;
    border-radius: 4px;
    font-family: $monoFamily;
    font-size: 12px;
    margin: 0;
    white-space: pre-wrap;
    word-wrap: break-word;
}
.segment.thought .segment-body pre {
    background: $codeBg;
}
.activity-segment {
    margin: 1px 0;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid $borderColor;
    width: 80%;
}
.segment-header {
    padding: 4px 8px;
    font-size: 12px;
    font-weight: bold;
    display: flex;
    align-items: center;
    gap: 4px;
    background: $base2;
}
.segment-header img {
    width: 16px;
    height: 16px;
}
.thought .segment-header {
    border-left: 4px solid $yellow;
}
.tool .segment-header {
    border-left: 4px solid $accent;
}
.thought .segment-body {
    border-left: 4px solid $yellow;
}
.tool .segment-body {
    border-left: 4px solid $accent;
}
